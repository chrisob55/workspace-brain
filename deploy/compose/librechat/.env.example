# Copy to deploy/compose/.env, or run `pnpm librechat:env` to create it with
# freshly generated development-only secrets. The real .env is git-ignored.
LIBRECHAT_PORT=3080

# Required by LibreChat. Generate with `openssl rand -hex 32` (CREDS_KEY and
# both JWT secrets) and `openssl rand -hex 16` (CREDS_IV). Never reuse values.
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# Optional model provider keys. Leave unset to enter a key in the LibreChat UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: extra turbo flags for the image builds, e.g. --concurrency=1 on
# hosts with little memory (a 2 GB Colima VM otherwise OOMs during `pnpm build`).
TURBO_BUILD_ARGS=
