{
  "openapi": "3.1.0",
  "info": {
    "title": "Workspace Brain API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Catalogue is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Catalogue is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "listSources",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only source collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only workspace collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/repositories": {
      "get": {
        "operationId": "listRepositories",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only repository collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "extension",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\.[a-zA-Z0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only document metadata collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{documentId}/evidence": {
      "get": {
        "operationId": "listDocumentEvidence",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only extracted evidence for a document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid document ID, cursor, or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evidence/{evidenceId}/explanation": {
      "get": {
        "operationId": "getEvidenceExplanation",
        "parameters": [
          {
            "name": "evidenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence, document version, exact locator, and processing provenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceExplanation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid evidence ID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Evidence was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/models": {
      "get": {
        "operationId": "listKnowledgeModels",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only Knowledge Model collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeModelPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/models/{modelId}": {
      "get": {
        "operationId": "getKnowledgeModel",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Knowledge Model metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeModel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Knowledge Model ID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Knowledge Model was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/entities": {
      "get": {
        "operationId": "listKnowledgeEntities",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "knowledgeModelId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "publicationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "enum": ["package", "container", "api", "module"]
            }
          },
          {
            "name": "lifecycleStatus",
            "in": "query",
            "schema": {
              "enum": [
                "observed",
                "verified",
                "established",
                "rejected",
                "superseded"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only knowledge entity collection; publicationId selects an immutable snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeEntityPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/entities/{entityId}": {
      "get": {
        "operationId": "getKnowledgeEntity",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current knowledge entity with evidence and provenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeEntity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid knowledge entity ID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Knowledge entity was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/relationships": {
      "get": {
        "operationId": "listKnowledgeRelationships",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "knowledgeModelId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "publicationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "enum": [
                "CONTAINS",
                "BELONGS_TO",
                "REFERENCES",
                "DOCUMENTS",
                "DEPENDS_ON",
                "USES",
                "IMPLEMENTS",
                "EXPOSES",
                "CONSUMES",
                "CLASSIFIED_AS",
                "DERIVED_FROM"
              ]
            }
          },
          {
            "name": "lifecycleStatus",
            "in": "query",
            "schema": {
              "enum": [
                "observed",
                "related",
                "verified",
                "established",
                "rejected",
                "superseded"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only knowledge relationship collection; publicationId selects an immutable snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeRelationshipPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/relationships/{relationshipId}": {
      "get": {
        "operationId": "getKnowledgeRelationship",
        "parameters": [
          {
            "name": "relationshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current evidence-backed knowledge relationship",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeRelationship"
                }
              }
            }
          },
          "400": {
            "description": "Invalid knowledge relationship ID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Knowledge relationship was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/publications": {
      "get": {
        "operationId": "listKnowledgePublications",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "knowledgeModelId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated immutable Knowledge Model publication metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgePublicationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["ready", "not_ready"]
          }
        }
      },
      "Source": {
        "type": "object",
        "required": ["id", "name", "type", "containerPaths", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "const": "filesystem"
          },
          "containerPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRoot"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourceRoot": {
        "type": "object",
        "required": ["id", "sourceId", "absolutePath"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "absolutePath": {
            "type": "string"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": ["id", "name", "sourceIds", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "ulid"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourcePage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "WorkspacePage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "path",
          "repositoryType",
          "fingerprint",
          "discoveredAt",
          "lastSeenAt",
          "discoveryMethod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "path": {
            "type": "string"
          },
          "repositoryType": {
            "enum": ["git", "unknown"]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 inventory fingerprint."
          },
          "discoveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "discoveryMethod": {
            "const": "filesystem"
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "path",
          "filename",
          "extension",
          "sizeBytes",
          "modifiedAt",
          "fingerprint",
          "discoveredAt",
          "lastSeenAt",
          "discoveryMethod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "path": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "extension": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 inventory fingerprint."
          },
          "discoveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "discoveryMethod": {
            "const": "filesystem"
          }
        }
      },
      "RepositoryPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Repository"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "DocumentPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "EvidenceLocator": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "lineStart", "lineEnd"],
            "properties": {
              "kind": {
                "enum": ["markdown-lines", "text-lines", "yaml-lines"]
              },
              "lineStart": {
                "type": "integer",
                "minimum": 1
              },
              "lineEnd": {
                "type": "integer",
                "minimum": 1
              },
              "headingPath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["kind", "pointer"],
            "properties": {
              "kind": {
                "const": "json-pointer"
              },
              "pointer": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "documentVersionId",
          "key",
          "kind",
          "excerpt",
          "truncated",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
