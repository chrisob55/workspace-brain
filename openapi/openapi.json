{
  "openapi": "3.1.0",
  "info": {
    "title": "Workspace Brain API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Catalogue is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Catalogue is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "listSources",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only source collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only workspace collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/repositories": {
      "get": {
        "operationId": "listRepositories",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only repository collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "ulid"
            }
          },
          {
            "name": "extension",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\.[a-zA-Z0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated read-only document metadata collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters or pagination parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["ready", "not_ready"]
          }
        }
      },
      "Source": {
        "type": "object",
        "required": ["id", "name", "type", "containerPaths", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "const": "filesystem"
          },
          "containerPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRoot"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourceRoot": {
        "type": "object",
        "required": ["id", "sourceId", "absolutePath"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "absolutePath": {
            "type": "string"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": ["id", "name", "sourceIds", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "ulid"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourcePage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "WorkspacePage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "Repository": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "path",
          "repositoryType",
          "fingerprint",
          "discoveredAt",
          "lastSeenAt",
          "discoveryMethod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "path": {
            "type": "string"
          },
          "repositoryType": {
            "enum": ["git", "unknown"]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 inventory fingerprint."
          },
          "discoveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "discoveryMethod": {
            "const": "filesystem"
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "path",
          "filename",
          "extension",
          "sizeBytes",
          "modifiedAt",
          "fingerprint",
          "discoveredAt",
          "lastSeenAt",
          "discoveryMethod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "ulid"
          },
          "sourceId": {
            "type": "string",
            "format": "ulid"
          },
          "path": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "extension": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 inventory fingerprint."
          },
          "discoveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "discoveryMethod": {
            "const": "filesystem"
          }
        }
      },
      "RepositoryPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Repository"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "DocumentPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
